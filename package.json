{
  "name": "dusk-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native",
    "native:sync:android": "npm run build:native && cap sync android",
    "native:sync:ios": "npm run build:native && cap sync ios",
    "native:open:android": "cap open android",
    "native:open:ios": "cap open ios",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backend:start": "node scripts/local-backend.mjs start",
    "backend:stop": "node scripts/local-backend.mjs stop",
    "backend:status": "node scripts/local-backend.mjs status",
    "backend:reset": "node scripts/local-backend.mjs reset",
    "backend:test": "node scripts/local-backend.mjs test",
    "backend:test:api": "node --test --test-concurrency=1 scripts/backend-api.test.mjs",
    "backend:test:network": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/backend-network.test.ps1",
    "native:sync:android:local": "node scripts/native-local.mjs",
    "backend:test:customer": "node --test --test-concurrency=1 scripts/customer-auth.test.mjs",
    "build:check": "node scripts/check-public-build.mjs dist"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/google-maps": "8.0.1",
    "@capacitor/ios": "8.6.2",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/google.maps": "^3.66.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.1.0",
    "supabase": "3.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
