# Optional local development configuration only. The existing app does not read these.
DUSK_LOCAL_API_URL=http://127.0.0.1:55321
# Obtain local keys from the local CLI only when needed. Keep actual values untracked.
DUSK_LOCAL_PUBLISHABLE_KEY=
# Privileged local key is for test setup only. Never use VITE_ or DUSK_NATIVE_PUBLIC_ prefixes.
DUSK_LOCAL_SECRET_KEY=
